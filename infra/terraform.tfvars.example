# Only for running OpenTofu from your laptop; CI passes these as TF_VAR_* from the repository variables
# (docs/CONFIGURATION.md lists them all). Copy to terraform.tfvars (git-ignored), replace every <your-...> value.

# --- required (outputs of bootstrap/: tofu -chdir=bootstrap output)
tenancy_ocid     = "ocid1.tenancy.oc1..<your-tenancy-ocid>"
compartment_ocid = "ocid1.compartment.oc1..<your-compartment-ocid>"
region           = "<your-home-region>"
oci_profile      = "oracle-always-free-admin"

# --- optional (defaults shown)
# micro_ssh_public_key  = "ssh-ed25519 AAAA... you@laptop"  # PUBLIC key for the micro VMs (via the Bastion only)
# enable_micros         = true    # micro-edge (Tailscale exit node + AdGuard)
# enable_micro_kuma     = false   # needs a git repository of AutoKuma monitor files, see docs/WHAT-YOU-DO.md step 14
# node_count            = 2       # node_count x node_ocpus <= 2 and node_count x node_memory_gb <= 12 (Always Free)
# node_ocpus            = 1
# node_memory_gb        = 6
# kubernetes_version    = ""      # empty = the newest version Oracle offers
# bastion_allowed_cidrs = ["0.0.0.0/0"]
# patch_reboot_mode     = "alert" # alert | staggered | none
