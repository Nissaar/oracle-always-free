# micro-edge settings. Optional: the stack starts without a .env (cloud-init starts it).
# If you use it: sudo cp .env.example .env && sudo chmod 600 .env (it stays on the VM, never in git).

# Tailnet device name.
TS_HOSTNAME=micro-edge
# Optional reusable or one-off auth key (Tailscale admin -> Settings -> Keys).
# Empty = log in once with the link from `sudo docker compose logs tailscale`.
TS_AUTHKEY=
# Container images. The defaults follow the newest release; put a version tag here to pin one
# (for example TAILSCALE_IMAGE=tailscale/tailscale:v1.x.y) and run `sudo docker compose pull && sudo docker compose up -d`.
# TAILSCALE_IMAGE=tailscale/tailscale:latest
# ADGUARD_IMAGE=adguard/adguardhome:latest
# REGISTRY_IMAGE=registry:latest
